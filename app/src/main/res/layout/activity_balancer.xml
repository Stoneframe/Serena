<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical"
    android:padding="@dimen/space_md"
    tools:context=".gui.balancers.BalanceActivity">

    <TextView
        android:id="@+id/textViewName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_sm"
        android:textAppearance="@style/TextAppearance.Serena.ScreenTitle" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_surface_card"
        android:elevation="@dimen/card_elevation"
        android:padding="@dimen/space_sm">

        <TextView
            android:id="@+id/textViewTransactionAvailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="0000"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_surface_card"
        android:elevation="@dimen/card_elevation"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_control_height"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/bg_input">

                    <Spinner
                        android:id="@+id/spinnerTransactionType"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="Transaction type"
                        android:paddingStart="12dp"
                        android:paddingEnd="44dp"
                        android:spinnerMode="dropdown" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_drop_down" />

                </FrameLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_control_height"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/editTextAmount"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:hint="Amount"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/textViewAmountUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="12dp"
                        android:textAppearance="@style/TextAppearance.Serena.Supporting"
                        tools:text="kcal" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRemoveTransactionType"
                style="@style/Widget.Serena.Button.Icon.Danger"
                android:layout_width="@dimen/control_min_height"
                android:layout_height="@dimen/control_min_height"
                android:contentDescription="@string/remove_transaction_type"
                android:tooltipText="@string/remove_transaction_type"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/button_danger_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditTransactionType"
                style="@style/Widget.Serena.Button.Icon.Secondary"
                android:layout_width="@dimen/control_min_height"
                android:layout_height="@dimen/control_min_height"
                android:layout_marginStart="@dimen/space_sm"
                android:contentDescription="@string/edit_transaction_type"
                android:tooltipText="@string/edit_transaction_type"
                app:icon="@drawable/ic_edit"
                app:iconTint="@color/button_secondary_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonNewTransactionType"
                style="@style/Widget.Serena.Button.Icon.Secondary"
                android:layout_width="@dimen/control_min_height"
                android:layout_height="@dimen/control_min_height"
                android:layout_marginStart="@dimen/space_sm"
                android:contentDescription="@string/new_transaction_type"
                android:tooltipText="@string/new_transaction_type"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/button_secondary_text" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/buttonAddCalories"
                style="@style/Widget.Serena.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Add" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_sm"
        android:text="Favorites"
        android:textAppearance="@style/TextAppearance.Serena.SectionTitle" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/space_sm"
        android:layout_weight="1"
        android:background="@drawable/bg_surface_card"
        android:elevation="@dimen/card_elevation"
        android:padding="@dimen/space_sm">

        <ListView
            android:id="@+id/listFavorites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/outline"
            android:dividerHeight="1dp"
            android:listSelector="@color/surface_pressed" />

        <TextView
            android:id="@+id/textViewEmptyFavorites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="No favorites yet"
            android:textAppearance="@style/TextAppearance.Serena.Supporting" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/buttonDone"
            style="@style/Widget.Serena.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Done" />

    </LinearLayout>

</LinearLayout>
