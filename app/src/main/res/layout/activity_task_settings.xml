<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context="stoneframe.serena.gui.tasks.TaskSettingsActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/cancelButton"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/limitTasksCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Limit tasks per day" />

                <TextView
                    android:id="@+id/maximumTasksTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_marginTop="@dimen/space_sm"
                    android:labelFor="@+id/maximumTasksEditText"
                    android:text="Maximum tasks per day" />

                <EditText
                    android:id="@+id/maximumTasksEditText"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:autofillHints=""
                    android:inputType="number"
                    tools:ignore="LabelFor" />

                <TextView
                    style="@style/TextAppearance.Serena.Supporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Tasks due in fewer than 7 days are always shown." />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_md"
                android:background="@color/outline" />

            <CheckBox
                android:id="@+id/smsTaskCreationCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                android:saveEnabled="false"
                android:text="@string/task_sms_creation" />

            <TextView
                android:id="@+id/smsPermissionWarningTextView"
                style="@style/TextAppearance.Serena.Supporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                android:layout_marginTop="@dimen/space_sm"
                android:visibility="gone"
                tools:text="@string/task_sms_permission_unavailable" />

            <TextView
                style="@style/TextAppearance.Serena.Supporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/task_sms_trusted_sender_help" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/trustedSmsSendersList"
                android:layout_width="match_parent"
                android:layout_height="@dimen/task_settings_contact_list_height"
                android:layout_marginHorizontal="@dimen/task_settings_contact_list_horizontal_margin"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_surface_card"
                android:nestedScrollingEnabled="true"
                android:padding="@dimen/space_sm"
                tools:listitem="@layout/list_item_trusted_sms_sender" />

            <Button
                android:id="@+id/addTrustedSmsSenderButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                android:text="@string/task_sms_add_trusted_number" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/cancelButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        android:text="Cancel"
        tools:ignore="ButtonOrder" />

    <Button
        android:id="@+id/saveButton"
        style="@style/Widget.Serena.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        android:text="Save" />

</RelativeLayout>
