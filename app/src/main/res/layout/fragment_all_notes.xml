<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".gui.notes.AllNotesFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ExpandableListView
            android:id="@+id/note_groups_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="50dp"
            android:layout_weight="1"
            android:divider="@color/outline"
            android:dividerHeight="1dp"
            android:indicatorLeft="?android:attr/expandableListPreferredItemIndicatorLeft" />

        <Button
            android:id="@+id/groups_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:text="Groups..." />

        <ImageButton
            android:id="@+id/expand_groups_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_toLeftOf="@+id/collapse_groups_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Expand all groups"
            android:padding="12dp"
            android:src="@drawable/ic_groups_expand"
            app:tint="@color/brand_primary" />

        <ImageButton
            android:id="@+id/collapse_groups_button"
            android:layout_toLeftOf="@+id/add_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Collapse all groups"
            android:padding="12dp"
            android:src="@drawable/ic_groups_collapse"
            app:tint="@color/brand_primary"
            android:layout_marginEnd="20dp"/>

        <Button
            style="@style/Widget.Serena.Button.Primary"
            android:id="@+id/add_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:text="Add" />

    </RelativeLayout>
</FrameLayout>
