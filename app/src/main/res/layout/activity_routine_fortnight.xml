<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_edit_chore"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context="stoneframe.serena.gui.routines.fortnights.FortnightRoutineActivity">

    <LinearLayout
        android:id="@+id/routine"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/cancelButton"
        android:layout_marginBottom="@dimen/space_sm"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:text="Name:" />

            <EditText
                style="@style/Widget.Serena.EditText.Compact"
                android:id="@+id/nameTextEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="9dp"
                android:layout_weight="1"
                android:hint="Enter routine name"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="1"
                />

            <CheckBox
                android:id="@+id/enabledCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Enable" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Date:" />

            <EditText
                style="@style/Widget.Serena.EditText.Compact"
                android:id="@+id/fortnight_routine_start_date_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:focusable="false"
                android:inputType="date"
                android:maxLines="1"
                android:importantForAutofill="no" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:weightSum="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_surface_card"
                    android:elevation="@dimen/card_elevation"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_section_header"
                        android:padding="10dp"
                        android:text="Week 1"
                        android:textColor="@color/on_brand"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ExpandableListView
                        android:id="@+id/week1_procedure_list"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:divider="@color/outline"
                        android:dividerHeight="1dp"
                        android:indicatorLeft="?android:attr/expandableListPreferredItemIndicatorLeft" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_surface_card"
                    android:elevation="@dimen/card_elevation"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_section_header"
                        android:padding="10dp"
                        android:text="Week 2"
                        android:textColor="@color/on_brand"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ExpandableListView
                        android:id="@+id/week2_procedure_list"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:divider="@color/outline"
                        android:dividerHeight="1dp"
                        android:indicatorLeft="?android:attr/expandableListPreferredItemIndicatorLeft" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/cancelButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:text="Cancel"
        tools:ignore="ButtonOrder" />

    <Button
        android:id="@+id/addProcedureButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_gravity="end"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@id/saveButton"
        android:text="ADD..." />

    <Button
        style="@style/Widget.Serena.Button.Primary"
        android:id="@+id/saveButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:text="Save" />

</RelativeLayout>
